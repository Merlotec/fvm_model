# Machine-specific settings for scripts/submit_isambard_pair.sh.
#
#   cp scripts/isambard_pair.env.example scripts/isambard_pair.env
#
# scripts/isambard_pair.env is gitignored: it holds paths and an account that
# are specific to one machine and one user, so it is not part of the experiment.
# The experiment definition belongs in a COMMITTED file instead -- see
# scripts/experiments/pair_A.env -- because that is what makes the corpus
# reproducible.
#
# Every assignment uses `: "${VAR:=value}"`, which only sets VAR if it is not
# already set.  That is what lets a one-off override on the command line win:
#
#   OUT=$HOME/data/pair_B ./scripts/submit_isambard_pair.sh

# --- where the corpora land (plan.json goes here too) ----------------------
: "${OUT:=$HOME/data/pair_A}"

# --- the fvm_solver checkout.  Must be on `main`: the NonMonotonic viscosity
# --- model lives there, and the run_isambard branch is 22 commits behind.
: "${SOLVER_DIR:=$HOME/flsim/fvm_solver}"

# --- cluster.  Leave unset to take the cluster defaults. --------------------
# : "${ACCOUNT:=}"
# : "${PARTITION:=}"

# --- hardware.  cpu is the default; cuda also asks for a GPU per shard. -----
: "${FVM_DEVICE:=cpu}"
: "${CPUS:=8}"

# --- parallelism and walltime ----------------------------------------------
: "${NSHARDS:=8}"
# : "${THROTTLE:=4}"        # cap concurrent array tasks per arm
: "${T_PLAN:=02:00:00}"
: "${T_GEN:=12:00:00}"
: "${T_FIN:=00:30:00}"
