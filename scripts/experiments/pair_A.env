# Experiment definition for the context-switching comparison -- COMMITTED.
#
#   ENV_FILE=scripts/experiments/pair_A.env ./scripts/submit_isambard_pair.sh
#
# This file is the paper's record of what was generated, so it is tracked in
# git while the machine-specific settings (OUT, ACCOUNT, SOLVER_DIR) are not.
# Note plan.json records all of this again once plan has run, and from then on
# the plan is the authority -- editing this file does not alter a built corpus.

# Trajectories per arm.  ~5% above what is needed: some contexts are too stiff
# for some ICs and diverge, and reconcile drops those from BOTH arms.
: "${TRAJ:=135}"

# Segments per trajectory.  Each segment writes steps_per_segment+1 = 31
# frames, and consecutive segments SHARE their boundary frame (segment s+1's
# t=0 is segment s's final state), so 4 segments = 124 files but 121 distinct
# states per trajectory.  Counts are per ARM: both arms get TRAJ trajectories.
: "${SEGMENTS:=4}"

# Shared context pool.  Unset means = TRAJ, which gives both arms the same K
# contexts AND the same SEGMENTS of frames each.  Must divide TRAJ and TRAJ*
# SEGMENTS, and must be >= SEGMENTS.
# : "${CONTEXTS:=}"

# Distinct geometries, shared by both arms.
: "${MESHES:=8}"

# dt FIXED across the whole pair: a varying frame interval can only be read
# from the dynamics, so it would force dynamic encoding in BOTH arms and hide
# whether the frozen arm leans on static appearance.  0.02 is the geometric
# centre of the training spec's LogU(0.01, 0.04).
: "${SAVE_T_SCOPE:=fixed}"
: "${SAVE_T:=0.02}"

# Set explicitly: left unset, plan draws fresh entropy and this file stops
# describing what was actually built.
: "${SEED:=20261031}"

# Distributions the contexts and ICs are drawn from.
: "${CONFIG:=fvm_gen/gen_alternating.json}"
